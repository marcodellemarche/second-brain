# brain_tools: the only writer of the vault and the only holder of credentials.
# Default command serves the MCP tools; the sidecars, the model gate and the watchdog reuse this
# image and override the command (python -m second_brain.sidecars.vault_watcher, and so on).
FROM python:3.12-slim

# git is what the vault ops use to commit and to walk history.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md /build/
COPY src /build/src
RUN pip install --no-cache-dir /build && rm -rf /build

# The data and guard volumes take their initial owner from these directories, and the services
# that mount them run as different uids.
RUN useradd --create-home --uid 23002 brain \
    && mkdir -p /app /data /guard \
    && chown 23002:23002 /data \
    && chown 23001:23001 /guard

# A plain 755 path, not the home: a container running as another uid still has to enter it, and
# pydantic-settings reads `.env` from the working directory.
WORKDIR /app
USER brain

CMD ["python", "-m", "second_brain.tools.server"]
