# The terminal container Hermes reaches over ssh (terminal.backend: ssh). It runs nothing else:
# a shell, the tools the agent needs, and sshd. No Docker socket, no credentials, and the vault
# mounted read-only, because Hermes' file tools run here and see the same `/vault` paths.
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server \
        poppler-utils \
        python3 \
        ripgrep \
        git \
    && rm -rf /var/lib/apt/lists/*

# Key-only access: authorized_keys is mounted by the host operator, so there is no password to set.
# The uid is fixed because the tmpfs mounts of /home/agent and the workspace are written as this
# one, and a container running read-only cannot chown them afterwards.
RUN useradd --uid 1000 --create-home --shell /bin/bash agent \
    && mkdir -p /run/sshd /etc/ssh/authorized_keys \
    && chown agent:agent /etc/ssh/authorized_keys

# No pid file: the image is read-only at runtime. StrictModes is off because the mounted
# authorized_keys belongs to the host operator, not to agent. The host key is mounted from the
# host: one generated here would change at every rebuild, and Hermes keeps the old one.
RUN printf '%s\n' \
    'Port 2222' \
    'HostKey /etc/ssh/terminal_host_key' \
    'PidFile none' \
    'PermitRootLogin no' \
    'PasswordAuthentication no' \
    'KbdInteractiveAuthentication no' \
    'ChallengeResponseAuthentication no' \
    'UsePAM no' \
    'PubkeyAuthentication yes' \
    'AuthorizedKeysFile /etc/ssh/authorized_keys/%u' \
    'AllowUsers agent' \
    'X11Forwarding no' \
    'PrintMotd no' \
    'StrictModes no' \
    > /etc/ssh/sshd_config

EXPOSE 2222
USER agent
WORKDIR /home/agent

CMD ["/usr/sbin/sshd", "-D", "-e"]
